PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cleanlife_db
DATABASE_SSL=false
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
ADMIN_API_KEY=change_this_to_a_long_random_admin_key
MOMO_WEBHOOK_SECRET=change_this_to_a_long_random_webhook_secret
CORS_ORIGIN=*

# PostgreSQL-backed dispatch timing.
DISPATCH_POLL_MS=15000
ADMIN_HOLD_MS=120000
TIER_CASCADE_STEP_MS=300000
